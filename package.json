{
  "name": "wallet-book",
  "version": "1.0.0",
  "description": "Decentralized address book dApp on BOT Chain",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "deploy:bot": "hardhat run scripts/deploy.cjs --network botChain",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "keywords": ["solidity", "web3", "bot-chain", "address-book"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0"
  }
}
